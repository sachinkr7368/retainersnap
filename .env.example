# Copy to .env.local for `pnpm dev`, and to .env.production before `pnpm deploy`.
# Quote any value that contains spaces. Never commit the copies.
# NEXT_PUBLIC_* values are inlined at build time. Set them before `pnpm deploy`.
# Server secrets on Cloudflare are also stored with `wrangler secret put` (see docs/SETUP.md).
# Nothing in this file that starts with NEXT_PUBLIC_ is a secret. The service role,
# cron secret, payment keys, Resend key, and PageSpeed key stay on the server.

# Public origin, no trailing slash.
# Local: http://localhost:3000
# Production: https://retainersnap.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API keys → anon public key
# (Dashboard label is "anon" or "publishable". Use the anon key this app expects.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API keys → service_role secret
# Server only. Bypasses row-level security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Generate with: openssl rand -hex 32
# Same value on the app worker and the cron worker.
# Cron worker calls POST /api/cron with Authorization: Bearer <this value>.
CRON_SECRET=

# Resend → API Keys → Create API key. https://resend.com/api-keys
# Leave blank to store alerts without sending mail.
RESEND_API_KEY=

# Resend → Domains → verify retainersnap.com, then use that from-address.
# Until the domain is verified, Resend's shared test sender works:
# RetainerSnap <onboarding@resend.dev>
RESEND_FROM="RetainerSnap <onboarding@resend.dev>"

# Google Cloud console → enable PageSpeed Insights API → Credentials → API key
# API: pagespeedonline.googleapis.com
# Restrict the key to that API. Server only.
PAGESPEED_API_KEY=

# Which adapter handles new checkouts. dodo is the default.
# Portal and cancel follow the provider stored on the subscription row.
# stripe | dodo
PAYMENT_PROVIDER=dodo

# Dodo Payments → Developer → API keys. https://app.dodopayments.com
# Use a test key while DODO_PAYMENTS_ENVIRONMENT=test_mode.
DODO_PAYMENTS_API_KEY=

# Dodo → Developer → Webhooks → signing secret for https://<host>/api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_KEY=

# test_mode until you are ready to charge. Then live_mode, with live keys and live product ids.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Dodo → Products. Create a subscription product for each price.
# Solo $19 / month, Studio $49 / month. Yearly is optional ($190 and $490).
# Leave yearly blank to hide the yearly buttons.
DODO_PRODUCT_SOLO_MONTHLY=
DODO_PRODUCT_SOLO_YEARLY=
DODO_PRODUCT_STUDIO_MONTHLY=
DODO_PRODUCT_STUDIO_YEARLY=

# Stripe test mode: https://dashboard.stripe.com/test/apikeys → Secret key (sk_test_...)
# Only required when PAYMENT_PROVIDER=stripe, or when an existing row has provider=stripe.
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → endpoint https://<host>/api/webhooks/stripe → signing secret
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints a whsec_ secret.
STRIPE_WEBHOOK_SECRET=

# Stripe → Product catalogue → recurring prices. Use price_ ids, not prod_ ids.
# Test mode prices while using sk_test. Yearly optional.
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
